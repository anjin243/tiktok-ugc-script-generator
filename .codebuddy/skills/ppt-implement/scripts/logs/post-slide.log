[2026-04-21 19:13:06] [DEBUG] [PPT PostToolUse Hook] stdin 数据: {"session_id":"2046652003580387328","transcript_path":"/root/.codebuddy/projects/workspace/2046652003580387328.jsonl","cwd":"/workspace","hook_event_name":"PostToolUse","tool_name":"Write","tool_input":{"content":"import { useState } from 'react';\nimport {\n  Dialog,\n  DialogContent,\n  DialogDescription,\n  DialogHeader,\n  DialogTitle,\n  DialogTrigger,\n} from '@/components/ui/dialog';\nimport { Button } from '@/components/ui/button';\nimport { Input } from '@/components/ui/input';\nimport { Label } from '@/components/ui/label';\nimport { toast } from 'sonner';\nimport { Settings, Info } from 'lucide-react';\n\ninterface ApiKeyConfig {\n  tencentSecretId: string;\n  tencentSecretKey: string;\n}\n\ninterface SettingsDialogProps {\n  onConfigChange?: (config: ApiKeyConfig) => void;\n}\n\nconst SettingsDialog = ({ onConfigChange }: SettingsDialogProps) => {\n  const [open, setOpen] = useState(false);\n  const [secretId, setSecretId] = useState('');\n  const [secretKey, setSecretKey] = useState('');\n  const [isSaving, setIsSaving] = useState(false);\n\n  // 从本地存储加载配置\n  useState(() => {\n    const saved = localStorage.getItem('ai_api_config');\n    if (saved) {\n      try {\n        const config = JSON.parse(saved);\n        setSecretId(config.tencentSecretId || '');\n        setSecretKey(config.tencentSecretKey || '');\n      } catch (e) {\n        console.error('Failed to load config:', e);\n      }\n    }\n  });\n\n  const handleSave = async () => {\n    if (!secretId.trim() || !secretKey.trim()) {\n      toast.error('请填写完整的API密钥信息');\n      return;\n    }\n\n    setIsSaving(true);\n    try {\n      // 保存到本地存储\n      const config: ApiKeyConfig = {\n        tencentSecretId: secretId.trim(),\n        tencentSecretKey: secretKey.trim(),\n      };\n      localStorage.setItem('ai_api_config', JSON.stringify(config));\n\n      // 通知后端保存配置\n      await fetch('/api/settings/api-key', {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify(config),\n      });\n\n      toast.success('API密钥配置成功，AI识别功能已启用');\n      onConfigChange?.(config);\n      setOpen(false);\n    } catch (error) {\n      console.error('Save config error:', error);\n      toast.error('保存失败，请重试');\n    } finally {\n      setIsSaving(false);\n    }\n  };\n\n  return (\n    <Dialog open={open} onOpenChange={setOpen}>\n      <DialogTrigger asChild>\n        <Button\n          variant=\"outline\"\n          size=\"sm\"\n          className=\"gap-2\"\n          style={{ borderColor: 'var(--border)', color: 'var(--foreground)' }}\n        >\n          <Settings className=\"w-4 h-4\" />\n          设置\n        </Button>\n      </DialogTrigger>\n      <DialogContent className=\"sm:max-w-md\" style={{\n        background: 'var(--card)',\n        color: 'var(--foreground)',\n        border: '1px solid var(--border)',\n      }}>\n        <DialogHeader>\n          <DialogTitle>AI识别配置</DialogTitle>\n          <DialogDescription style={{ color: 'var(--muted-foreground)' }}>\n            配置腾讯云API密钥以启用精准AI图像识别\n          </DialogDescription>\n        </DialogHeader>\n        \n        <div className=\"space-y-4 py-4\">\n          {/* 获取密钥指引 */}\n          <div \n            className=\"p-3 rounded-lg text-sm\"\n            style={{ background: 'var(--secondary)', color: 'var(--muted-foreground)' }}\n          >\n            <div className=\"flex items-start gap-2\">\n              <Info className=\"w-4 h-4 mt-0.5 flex-shrink-0\" />\n              <div className=\"space-y-2\">\n                <p className=\"font-medium\" style={{ color: 'var(--foreground)' }}>如何获取API密钥？</p>\n                <ol className=\"list-decimal list-inside space-y-1 text-xs\">\n                  <li>访问 <a href=\"https://console.cloud.tencent.com/cam/capi\" target=\"_blank\" rel=\"noopener noreferrer\" className=\"underline\" style={{ color: 'var(--primary)' }}>腾讯云控制台</a></li>\n                  <li>登录后进入「访问管理-访问密钥」</li>\n                  <li>点击「新建密钥」创建API密钥</li>\n                  <li>复制 SecretId 和 SecretKey 填入下方</li>\n                </ol>\n              </div>\n            </div>\n          </div>\n\n          {/* SecretId */}\n          <div className=\"space-y-2\">\n            <Label htmlFor=\"secretId\">SecretId</Label>\n            <Input\n              id=\"secretId\"\n              type=\"password\"\n              placeholder=\"请输入腾讯云 SecretId\"\n              value={secretId}\n              onChange={(e) => setSecretId(e.target.value)}\n              style={{\n                background: 'var(--input)',\n                color: 'var(--foreground)',\n                border: '1px solid var(--border)',\n              }}\n            />\n          </div>\n\n          {/* SecretKey */}\n          <div className=\"space-y-2\">\n            <Label htmlFor=\"secretKey\">SecretKey</Label>\n            <Input\n              id=\"secretKey\"\n              type=\"password\"\n              placeholder=\"请输入腾讯云 SecretKey\"\n              value={secretKey}\n              onChange={(e) => setSecretKey(e.target.value)}\n              style={{\n                background: 'var(--input)',\n                color: 'var(--foreground)',\n                border: '1px solid var(--border)',\n              }}\n            />\n          </div>\n\n          {/* 提示 */}\n          <p className=\"text-xs\" style={{ color: 'var(--muted-foreground)' }}>\n            密钥将安全存储在本地，仅用于AI图像识别服务\n          </p>\n        </div>\n\n        <div className=\"flex justify-end gap-2\">\n          <Button\n            variant=\"outline\"\n            onClick={() => setOpen(false)}\n            style={{ color: 'var(--foreground)', borderColor: 'var(--border)' }}\n          >\n            取消\n          </Button>\n          <Button\n            onClick={handleSave}\n            disabled={isSaving}\n            style={{\n              background: 'var(--primary)',\n              color: 'var(--primary-foreground)',\n            }}\n          >\n            {isSaving ? '保存中...' : '保存配置'}\n          </Button>\n        </div>\n      </DialogContent>\n    </Dialog>\n  );\n};\n\nexport default SettingsDialog;\n","file_path":"/workspace/frontend/src/components/SettingsDialog.tsx"},"tool_response":"Successfully created and wrote to new file: /workspace/frontend/src/components/SettingsDialog.tsx","client":"CLI","version":"2.90.0","generation_id":"556662f7c7b34465b42aae3f591ed8c3","model":"glm-5.0","call_id":"call_d42eb9bcfd554021bc6c7942"}
