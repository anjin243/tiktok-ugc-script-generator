error);\n          toast.info('图片上传成功，请手动填写商品信息');\n        } finally {\n          setIsRecognizing(false);\n        }\n      };\n      reader.readAsDataURL(firstFile);\n      \n      // 处理剩余图片\n      const remainingFiles = filesToProcess.slice(1);\n      remainingFiles.forEach(file => {\n        const reader = new FileReader();\n        reader.onload = (e) => {\n          const url = e.target?.result as string;\n          setPreviewUrls(prev => [...prev, url]);\n          setReferenceImages(prev => [...prev, url]);\n        };\n        reader.readAsDataURL(file);\n      });\n    } else {\n      // 非第一张图片，直接添加\n      filesToProcess.forEach(file => {\n        const reader = new FileReader();\n        reader.onload = (e) => {\n          const url = e.target?.result as string;\n          setPreviewUrls(prev => [...prev, url]);\n          setReferenceImages(prev => [...prev, url]);\n        };\n        reader.readAsDataURL(file);\n      });\n    }\n    \n    // 清空 input\n    if (fileInputRef.current) {\n      fileInputRef.current.value = '';\n    }\n  };","old_string":"  // 处理图片上传\n  const handleImageUpload = (event: React.ChangeEvent<HTMLInputElement>) => {\n    const files = event.target.files;\n    if (!files) return;\n    \n    const remainingSlots = 5 - referenceImages.length;\n    const filesToProcess = Array.from(files).slice(0, remainingSlots);\n    \n    if (filesToProcess.length === 0) {\n      toast.error('最多上传5张参考图');\n      return;\n    }\n    \n    // 检查文件大小（限制1MB）\n    const maxSize = 1 * 1024 * 1024; // 1MB\n    const oversizedFiles = filesToProcess.filter(file => file.size > maxSize);\n    if (oversizedFiles.length > 0) {\n      toast.error(`图片大小不能超过1MB，请压缩后重试`);\n      return;\n    }\n    \n    filesToProcess.forEach(file => {\n      const reader = new FileReader();\n      reader.onload = (e) => {\n        const url = e.target?.result as string;\n        setPreviewUrls(prev => [...prev, url]);\n        // 注意：这里使用 base64 作为演示，实际项目中应该上传到服务器\n        setR