[2026-04-21 19:56:36] [DEBUG] [PPT PostToolUse Hook] stdin 数据: {"session_id":"2046652003580387328","transcript_path":"/root/.codebuddy/projects/workspace/2046652003580387328.jsonl","cwd":"/workspace","hook_event_name":"PostToolUse","tool_name":"Write","tool_input":{"content":"import { Router, Request, Response } from 'express';\nimport { PrismaClient } from '@prisma/client';\nimport { z } from 'zod';\nimport { GenerateScriptSchema, UGCStyle, Language } from '../types/product.types';\n\nconst router = Router();\nconst prisma = new PrismaClient();\n\n// AI视频生成模型兼容的分镜Prompt模板\n// 适用于: Veo3.1, 即梦, 可灵, Runway Gen-3, Pika, Sora等\n\ninterface ScenePrompt {\n  order: number;\n  duration: number;\n  \n  // AI视频生成专用字段\n  visualPrompt: string;      // 英文画面描述（给AI模型用）\n  visualPromptCN: string;   // 中文画面描述（给用户看）\n  \n  // 镜头语言\n  cameraMovement: string;    // 镜头运动: push in, pull out, pan left, tilt down, static, handheld\n  cameraAngle: string;       // 镜头角度: close-up, medium shot, wide shot, bird's eye, low angle\n  cameraDistance: string;   // 景别: extreme close-up, close-up, medium close-up, medium, medium wide, wide, extreme wide\n  \n  // 画面元素\n  subject: string;           // 主体\n  action: string;            // 动作\n  environment: string;      // 环境/背景\n  lighting: string;          // 光线: soft natural light, studio lighting, golden hour, dramatic lighting\n  mood: string;              // 情绪氛围: warm, energetic, calm, dramatic, playful\n  colorTone: string;         // 色调: warm tones, cool tones, vibrant, muted, high contrast\n  \n  // 过渡效果\n  transition: string;        // 转场: cut, fade, dissolve, wipe, zoom\n  \n  // 音频相关\n  voiceover: string;         // 口播文案\n  musicSuggestion: string;   // 音乐建议\n  \n  // 时间控制\n  startTime: number;         // 开始时间（秒）\n  endTime: number;           // 结束时间（秒）\n}\n\n// 镜头运动选项\nconst CAMERA_MOVEMENTS = {\n  static: 'static shot, camera stays still',\n  pushIn: 'slow push in, camera moves closer to subject',\n  pullOut: 'pull out, camera moves away from subject',\n  pan: 'pan right, camera rotates horizontally',\n  panLeft: 'pan left, camera rotates left',\n  tilt: 'tilt down, camera rotates vertically downward',\n  tiltUp: 'tilt up, camera rotates upward',\n  tracking: 'tracking shot, camera follows subject',\n  handheld: 'handheld camera, slight natural movement',\n  dolly: 'dolly shot, smooth camera movement on rails',\n  zoom: 'slow zoom in',\n  craneUp: 'crane up, camera rises above subject',\n};\n\n// 景别选项\nconst CAMERA_DISTANCE = {\n  extremeCloseUp: 'extreme close-up, macro detail',\n  closeUp: 'close-up shot, face and shoulders',\n  mediumCloseUp: 'medium close-up, head and upper body',\n  medium: 'medium shot, waist up',\n  mediumWide: 'medium wide shot, knees up',\n  wide: 'wide shot, full body with environment',\n  extremeWide: 'extreme wide shot, establishing shot',\n};\n\n// 光线选项\nconst LIGHTING_OPTIONS = {\n  softNatural: 'soft natural lighting, even illumination',\n  golden: 'golden hour lighting, warm sunset glow',\n  studio: 'professional studio lighting, three-point setup',\n  dramatic: 'dramatic lighting, high contrast shadows',\n  backlight: 'backlit, silhouette effect with rim light',\n  soft: 'soft diffused lighting, gentle shadows',\n  bright: 'bright daylight, high key lighting',\n  moody: 'moody lighting, atmospheric shadows',\n};\n\n// 视频风格模板（针对AI视频生成优化）\nconst VIDEO_STYLE_TEMPLATES: Record<UGCStyle, {\n  name: string;\n  description: string;\n  basePrompt: string;\n  cameraStyle: string;\n  lightingStyle: string;\n  mood: string;\n  transitions: string[];\n}> = {\n  unboxing: {\n    name: '开箱测评',\n    description: '沉浸式开箱体验',\n    basePrompt: 'unboxing video, product reveal, hands opening package',\n    cameraStyle: 'handheld, POV shots',\n    lightingStyle: 'soft natural lighting',\n    mood: 'excited, anticipatory',\n    transitions: ['cut', 'zoom', 'cut'],\n  },\n  usage: {\n    name: '使用分享',\n    description: '真实场景使用展示',\n    basePrompt: 'lifestyle video, product in use, authentic moment',\n    cameraStyle: 'natural handheld, documentary style',\n    lightingStyle: 'soft natural lighting',\n    mood: 'authentic, relatable, warm',\n    transitions: ['cut', 'dissolve', 'cut'],\n  },\n  comparison: {\n    name: '对比测评',\n    description: '产品对比分析',\n    basePrompt: 'product comparison, side by side, split screen',\n    cameraStyle: 'static, controlled movements',\n    lightingStyle: 'studio lighting',\n    mood: 'objective, informative',\n    transitions: ['cut', 'wipe', 'cut'],\n  },\n  story: {\n    name: '剧情植入',\n    description: '故事化场景演绎',\n    basePrompt: 'narrative scene, storytelling, emotional moment',\n    cameraStyle: 'cinematic, smooth tracking',\n    lightingStyle: 'cinematic lighting',\n    mood: 'emotional, engaging',\n    transitions: ['dissolve', 'fade', 'dissolve'],\n  },\n  voiceover: {\n    name: '口播讲解',\n    description: '直播带货风格',\n    basePrompt: 'talking head, presenter speaking to camera',\n    cameraStyle: 'static with occasional push in',\n    lightingStyle: 'studio lighting, ring light',\n    mood: 'energetic, persuasive',\n    transitions: ['cut', 'cut', 'cut'],\n  },\n};\n\n// 根据风格生成分镜\nfunction generateVideoScenes(\n  style: UGCStyle,\n  productName: string,\n  category: string,\n  sellingPoints: string[],\n  duration: number,\n  referenceImages: string[],\n  language: Language\n): ScenePrompt[] {\n  const styleTemplate = VIDEO_STYLE_TEMPLATES[style];\n  const scenes: ScenePrompt[] = [];\n  \n  // 计算场景数和时间分配\n  const sceneCount = duration <= 15 ? 3 : duration <= 30 ? 5 : 8;\n  const baseDuration = Math.floor(duration / sceneCount);\n  \n  // 根据风格生成不同场景\n  switch (style) {\n    case 'unboxing':\n      scenes.push({\n        order: 1,\n        duration: baseDuration,\n        visualPrompt: `Close-up shot of hands holding a beautifully packaged ${category} product box. Soft natural lighting, shallow depth of field. The packaging has premium design with brand logo visible. Excited anticipation mood.`,\n        visualPromptCN: `特写镜头：双手捧着精美包装的${category}产品盒子。柔和自然光线，浅景深。包装设计精致，品牌logo清晰可见。充满期待的氛围。`,\n        cameraMovement: CAMERA_MOVEMENTS.static,\n        cameraAngle: 'close-up',\n        cameraDistance: CAMERA_DISTANCE.closeUp,\n        subject: `hands holding ${productName} box`,\n        action: 'holding and examining package',\n        environment: 'clean minimal background, soft gradient',\n        lighting: LIGHTING_OPTIONS.softNatural,\n        mood: 'excited, anticipatory',\n        colorTone: 'warm tones, soft pastels',\n        transition: 'cut',\n        voiceover: language.startsWith('zh') ? `看这个包装，质感太好了！` : `Look at this packaging, so premium!`,\n        musicSuggestion: 'light upbeat background music',\n        startTime: 0,\n        endTime: baseDuration,\n      });\n      \n      scenes.push({\n        order: 2,\n        duration: baseDuration,\n        visualPrompt: `Slow motion unboxing: hands carefully opening the package, removing tissue paper, revealing the ${productName} inside. Soft lighting creates gentle shadows. Cinematic reveal moment.`,\n        visualPromptCN: `慢动作开箱：双手小心翼翼地打开包装，揭开包装纸，露出里面的${productName}。柔和光线营造温柔阴影。电影感的揭晓时刻。`,\n        cameraMovement: CAMERA_MOVEMENTS.pushIn,\n        cameraAngle: 'medium close-up',\n        cameraDistance: CAMERA_DISTANCE.mediumCloseUp,\n        subject: `${productName} in package`,\n        action: 'unboxing, revealing product',\n        environment: 'clean white surface, minimal styling',\n        lighting: LIGHTING_OPTIONS.soft,\n        mood: 'satisfying, reveal',\n        colorTone: 'clean, bright, white dominant',\n        transition: 'dissolve',\n        voiceover: language.startsWith('zh') ? `慢慢打开...哇！` : `Slowly opening... wow!`,\n        musicSuggestion: 'soft ambient sound, paper rustling',\n        startTime: baseDuration,\n        endTime: baseDuration * 2,\n      });\n      \n      scenes.push({\n        order: 3,\n        duration: baseDuration,\n        visualPrompt: `Extreme close-up macro shot of ${productName} surface texture and details. Shallow depth of field, focus pulling across product features. Premium quality visible in every detail.`,\n        visualPromptCN: `微距特写：${productName}表面纹理和细节。浅景深，焦点在产品特性间移动。每个细节都展现高端品质。`,\n        cameraMovement: CAMERA_MOVEMENTS.pushIn,\n        cameraAngle: 'extreme close-up',\n        cameraDistance: CAMERA_DISTANCE.extremeCloseUp,\n        subject: `${productName} details`,\n        action: 'focus pulling, revealing texture',\n        environment: 'blurred neutral background',\n        lighting: LIGHTING_OPTIONS.studio,\n        mood: 'premium, detailed',\n        colorTone: 'product accurate colors',\n        transition: 'cut',\n        voiceover: language.startsWith('zh') ? `${sellingPoints[0] || '这个质感绝了'}` : `${sellingPoints[0] || 'This quality is amazing'}`,\n        musicSuggestion: 'subtle ambient music',\n        startTime: baseDuration * 2,\n        endTime: baseDuration * 3,\n      });\n\n      if (sceneCount >= 5) {\n        scenes.push({\n          order: 4,\n          duration: baseDuration,\n          visualPrompt: `Medium shot of ${productName} in use by a person in natural setting. Lifestyle moment, authentic usage demonstration. Soft natural window light, warm atmosphere.`,\n          visualPromptCN: `中景：在自然环境中使用${productName}的人物。生活化场景，真实使用演示。柔和的窗户自然光，温暖氛围。`,\n          cameraMovement: CAMERA_MOVEMENTS.tracking,\n          cameraAngle: 'medium shot',\n          cameraDistance: CAMERA_DISTANCE.medium,\n          subject: `person using ${productName}`,\n          action: 'natural usage demonstration',\n          environment: 'home setting, natural lifestyle',\n          lighting: LIGHTING_OPTIONS.golden,\n          mood: 'authentic, relatable',\n          colorTone: 'warm, lifestyle tones',\n          transition: 'dissolve',\n          voiceover: language.startsWith('zh') ? `${sellingPoints[1] || '用起来太顺手了'}` : `${sellingPoints[1] || 'So easy to use'}`,\n          musicSuggestion: 'warm acoustic background',\n          startTime: baseDuration * 3,\n          endTime: baseDuration * 4,\n        });\n        \n        scenes.push({\n          order: 5,\n          duration: baseDuration,\n          visualPrompt: `Final product showcase: ${productName} beautifully arranged with supporting elements. Pull out to wide shot. Call to action text overlay space. Brand moment.`,\n          visualPromptCN: `最终产品展示：${productName}精美摆放，配以支撑元素。拉远到全景。留出行动号召文字空间。品牌时刻。`,\n          cameraMovement: CAMERA_MOVEMENTS.pullOut,\n          cameraAngle: 'wide shot',\n          cameraDistance: CAMERA_DISTANCE.wide,\n          subject: `${productName} final showcase`,\n          action: 'hero product shot',\n          environment: 'styled product photography setup',\n          lighting: LIGHTING_OPTIONS.studio,\n          mood: 'premium, satisfying',\n          colorTone: 'brand colors, cohesive palette',\n          transition: 'fade',\n          voiceover: language.startsWith('zh') ? `${productName}，值得拥有！链接在评论区` : `${productName}, get yours now! Link in description`,\n          musicSuggestion: 'upbeat ending music',\n          startTime: baseDuration * 4,\n          endTime: baseDuration * 5,\n        });\n      }\n      break;\n\n    case 'usage':\n      scenes.push({\n        order: 1,\n        duration: baseDuration,\n        visualPrompt: `Medium wide shot: Person in casual setting discovering they need ${productName}. Natural lighting, authentic lifestyle moment. Subtle problem-solution narrative beginning.`,\n        visualPromptCN: `中全景：休闲环境中的人物发现需要${productName}。自然光线，真实生活场景。微妙的问题-解决方案叙事开始。`,\n        cameraMovement: CAMERA_MOVEMENTS.static,\n        cameraAngle: 'medium wide',\n        cameraDistance: CAMERA_DISTANCE.mediumWide,\n        subject: `person in everyday situation`,\n        action: 'discovering need for product',\n        environment: 'home, natural lifestyle setting',\n        lighting: LIGHTING_OPTIONS.softNatural,\n        mood: 'relatable, authentic',\n        colorTone: 'natural, lifestyle colors',\n        transition: 'cut',\n        voiceover: language.startsWith('zh') ? `有没有遇到过这种情况...` : `Have you ever faced this situation...`,\n        musicSuggestion: 'light background music',\n        startTime: 0,\n        endTime: baseDuration,\n      });\n      \n      scenes.push({\n        order: 2,\n        duration: baseDuration,\n        visualPrompt: `Close-up: ${productName} appears on screen, hero product shot. Soft focus background, product in sharp focus. Premium product introduction moment.`,\n        visualPromptCN: `特写：${productName}出现在画面中，英雄产品镜头。背景柔焦，产品清晰对焦。高端产品介绍时刻。`,\n        cameraMovement: CAMERA_MOVEMENTS.pushIn,\n        cameraAngle: 'close-up',\n        cameraDistance: CAMERA_DISTANCE.closeUp,\n        subject: `${productName}`,\n        action: 'product reveal',\n        environment: 'clean minimal background',\n        lighting: LIGHTING_OPTIONS.studio,\n        mood: 'premium, solution',\n        colorTone: 'clean, product-focused',\n        transition: 'dissolve',\n        voiceover: language.startsWith('zh') ? `直到我发现了${productName}` : `Then I discovered ${productName}`,\n        musicSuggestion: 'subtle revelation sound',\n        startTime: baseDuration,\n        endTime: baseDuration * 2,\n      });\n      \n      scenes.push({\n        order: 3,\n        duration: baseDuration,\n        visualPrompt: `POV shot: First-person view of using ${productName}. Hands demonstrating key features. ${sellingPoints[0] || 'Key benefit'} clearly visible in action.`,\n        visualPromptCN: `第一人称视角：使用${productName}的画面。双手展示关键功能。${sellingPoints[0] || '核心优势'}清晰可见。`,\n        cameraMovement: CAMERA_MOVEMENTS.handheld,\n        cameraAngle: 'POV',\n        cameraDistance: CAMERA_DISTANCE.closeUp,\n        subject: `hands using ${productName}`,\n        action: `demonstrating ${sellingPoints[0] || 'key feature'}`,\n        environment: 'natural usage context',\n        lighting: LIGHTING_OPTIONS.soft,\n        mood: 'demonstrative, helpful',\n        colorTone: 'natural tones',\n        transition: 'cut',\n        voiceover: language.startsWith('zh') ? `${sellingPoints[0] || '看这个功能'}` : `${sellingPoints[0] || 'Check this feature'}`,\n        musicSuggestion: 'demonstration music',\n        startTime: baseDuration * 2,\n        endTime: baseDuration * 3,\n      });\n\n      if (sceneCount >= 5) {\n        scenes.push({\n          order: 4,\n          duration: baseDuration,\n          visualPrompt: `Medium shot: Happy satisfied person after using ${productName}. Natural smile, authentic reaction. Warm golden hour lighting creating positive emotional connection.`,\n          visualPromptCN: `中景：使用${productName}后满意开心的人物。自然微笑，真实反应。温暖黄金时段光线营造积极情感连接。`,\n          cameraMovement: CAMERA_MOVEMENTS.static,\n          cameraAngle: 'medium shot',\n          cameraDistance: CAMERA_DISTANCE.medium,\n          subject: `person with ${productName}`,\n          action: 'satisfied expression',\n          environment: 'warm lifestyle setting',\n          lighting: LIGHTING_OPTIONS.golden,\n          mood: 'satisfied, happy',\n          colorTone: 'warm, golden tones',\n          transition: 'dissolve',\n          voiceover: language.startsWith('zh') ? `${sellingPoints[1] || '效果真的很好'}` : `${sellingPoints[1] || 'It really works'}`,\n          musicSuggestion: 'uplifting music',\n          startTime: baseDuration * 3,\n          endTime: baseDuration * 4,\n        });\n        \n        scenes.push({\n          order: 5,\n          duration: baseDuration,\n          visualPrompt: `Product hero shot with call to action. ${productName} center frame, lifestyle context visible. Professional product photography style, soft shadows.`,\n          visualPromptCN: `产品英雄镜头配行动号召。${productName}居中，生活场景可见。专业产品摄影风格，柔和阴影。`,\n          cameraMovement: CAMERA_MOVEMENTS.pullOut,\n          cameraAngle: 'medium shot',\n          cameraDistance: CAMERA_DISTANCE.medium,\n          subject: `${productName} final shot`,\n          action: 'product showcase',\n          environment: 'lifestyle context',\n          lighting: LIGHTING_OPTIONS.studio,\n          mood: 'conclusive, inviting',\n          colorTone: 'brand aligned colors',\n          transition: 'fade',\n          voiceover: language.startsWith('zh') ? `${productName}，你的不二之选！评论区有链接` : `${productName}, your best choice! Link in comments`,\n          musicSuggestion: 'positive ending music',\n          startTime: baseDuration * 4,\n          endTime: baseDuration * 5,\n        });\n      }\n      break;\n\n    case 'comparison':\n      scenes.push({\n        order: 1,\n        duration: baseDuration,\n        visualPrompt: `Split screen: Two products side by side. Left side generic competitor, right side ${productName}. Neutral lighting, objective comparison setup. Clean professional look.`,\n        visualPromptCN: `分屏：两款产品并排。左侧普通竞品，右侧${productName}。中性光线，客观对比设置。干净专业外观。`,\n        cameraMovement: CAMERA_MOVEMENTS.static,\n        cameraAngle: 'wide shot',\n        cameraDistance: CAMERA_DISTANCE.wide,\n        subject: `two products comparison`,\n        action: 'side by side comparison',\n        environment: 'neutral comparison setting',\n        lighting: LIGHTING_OPTIONS.studio,\n        mood: 'objective, informative',\n        colorTone: 'neutral, balanced',\n        transition: 'cut',\n        voiceover: language.startsWith('zh') ? `今天来对比一下` : `Let's compare today`,\n        musicSuggestion: 'neutral background music',\n        startTime: 0,\n        endTime: baseDuration,\n      });\n      \n      scenes.push({\n        order: 2,\n        duration: baseDuration,\n        visualPrompt: `Close-up left side: Competitor product detail. Focus on common features or issues. Neutral documentation style.`,\n        visualPromptCN: `左侧特写：竞品产品细节。聚焦常见特性或问题。中性记录风格。`,\n        cameraMovement: CAMERA_MOVEMENTS.panLeft,\n        cameraAngle: 'close-up',\n        cameraDistance: CAMERA_DISTANCE.closeUp,\n        subject: `competitor product`,\n        action: 'showing competitor features',\n        environment: 'comparison setup',\n        lighting: LIGHTING_OPTIONS.studio,\n        mood: 'neutral, documenting',\n        colorTone: 'neutral tones',\n        transition: 'cut',\n        voiceover: language.startsWith('zh') ? `先看看普通款...` : `First, the regular one...`,\n        musicSuggestion: 'neutral music',\n        startTime: baseDuration,\n        endTime: baseDuration * 2,\n      });\n      \n      scenes.push({\n        order: 3,\n        duration: baseDuration,\n        visualPrompt: `Close-up right side: ${productName} detail shot. Premium features highlighted. Superior quality visible. Soft dramatic lighting emphasizing product advantages.`,\n        visualPromptCN: `右侧特写：${productName}细节镜头。高端特性突出。卓越品质可见。柔和戏剧性光线强调产品优势。`,\n        cameraMovement: CAMERA_MOVEMENTS.pan,\n        cameraAngle: 'close-up',\n        cameraDistance: CAMERA_DISTANCE.closeUp,\n        subject: `${productName}`,\n        action: 'showing superior features',\n        environment: 'comparison setup',\n        lighting: LIGHTING_OPTIONS.dramatic,\n        mood: 'impressive, superior',\n        colorTone: 'premium tones',\n        transition: 'wipe',\n        voiceover: language.startsWith('zh') ? `再看看${productName}...` : `Now ${productName}...`,\n        musicSuggestion: 'subtle positive shift in music',\n        startTime: baseDuration * 2,\n        endTime: baseDuration * 3,\n      });\n\n      if (sceneCount >= 5) {\n        scenes.push({\n          order: 4,\n          duration: baseDuration,\n          visualPrompt: `Feature comparison graphics overlay. Key points: ${sellingPoints.join(', ')}. Visual comparison chart animation. Professional infographic style.`,\n          visualPromptCN: `特性对比图表覆盖。关键点：${sellingPoints.join('、')}。可视化对比图表动画。专业信息图风格。`,\n          cameraMovement: CAMERA_MOVEMENTS.static,\n          cameraAngle: 'wide shot',\n          cameraDistance: CAMERA_DISTANCE.wide,\n          subject: `comparison graphics`,\n          action: 'data visualization',\n          environment: 'graphic overlay',\n          lighting: LIGHTING_OPTIONS.studio,\n          mood: 'informative, clear',\n          colorTone: 'brand colors, contrast',\n          transition: 'dissolve',\n          voiceover: language.startsWith('zh') ? `明显${productName}更胜一筹` : `Clearly ${productName} wins`,\n          musicSuggestion: 'upbeat informative music',\n          startTime: baseDuration * 3,\n          endTime: baseDuration * 4,\n        });\n        \n        scenes.push({\n          order: 5,\n          duration: baseDuration,\n          visualPrompt: `Final verdict: ${productName} hero shot. Winner badge/recommendation visual. Clear call to action. Satisfied customer endorsement.`,\n          visualPromptCN: `最终结论：${productName}英雄镜头。获胜者徽章/推荐视觉效果。清晰行动号召。满意客户背书。`,\n          cameraMovement: CAMERA_MOVEMENTS.pushIn,\n          cameraAngle: 'medium close-up',\n          cameraDistance: CAMERA_DISTANCE.mediumCloseUp,\n          subject: `${productName} winner shot`,\n          action: 'final recommendation',\n          environment: 'premium showcase',\n          lighting: LIGHTING_OPTIONS.studio,\n          mood: 'conclusive, recommended',\n          colorTone: 'brand colors',\n          transition: 'fade',\n          voiceover: language.startsWith('zh') ? `${productName}，明智之选！链接在评论区` : `${productName}, smart choice! Link in comments`,\n          musicSuggestion: 'positive conclusion music',\n          startTime: baseDuration * 4,\n          endTime: baseDuration * 5,\n        });\n      }\n      break;\n\n    case 'story':\n      scenes.push({\n        order: 1,\n        duration: baseDuration,\n        visualPrompt: `Cinematic wide shot: Person in relatable daily situation, facing a challenge that ${productName} can solve. Natural lighting, emotional storytelling beginning.`,\n        visualPromptCN: `电影感全景：人物处于可共鸣的日常情境，面临${productName}可以解决的挑战。自然光线，情感叙事开始。`,\n        cameraMovement: CAMERA_MOVEMENTS.craneUp,\n        cameraAngle: 'wide shot',\n        cameraDistance: CAMERA_DISTANCE.wide,\n        subject: `person in daily life challenge`,\n        action: 'struggling with problem',\n        environment: 'relatable everyday setting',\n        lighting: LIGHTING_OPTIONS.softNatural,\n        mood: 'relatable, emotional',\n        colorTone: 'natural, slightly muted',\n        transition: 'fade',\n        voiceover: language.startsWith('zh') ? `那是一个普通的日子...` : `It was just an ordinary day...`,\n        musicSuggestion: 'emotional piano music',\n        startTime: 0,\n        endTime: baseDuration,\n      });\n      \n      scenes.push({\n        order: 2,\n        duration: baseDuration,\n        visualPrompt: `Medium shot: Friend recommends ${productName}. Natural conversation moment, warm lighting. Trust and recommendation narrative.`,\n        visualPromptCN: `中景：朋友推荐${productName}。自然对话时刻，温暖光线。信任和推荐叙事。`,\n        cameraMovement: CAMERA_MOVEMENTS.static,\n        cameraAngle: 'medium shot',\n        cameraDistance: CAMERA_DISTANCE.medium,\n        subject: `friend recommendation moment`,\n        action: 'sharing discovery',\n        environment: 'social setting',\n        lighting: LIGHTING_OPTIONS.golden,\n        mood: 'warm, trustworthy',\n        colorTone: 'warm, inviting tones',\n        transition: 'dissolve',\n        voiceover: language.startsWith('zh') ? `然后朋友给我推荐了${productName}` : `Then a friend recommended ${productName}`,\n        musicSuggestion: 'hopeful music shift',\n        startTime: baseDuration,\n        endTime: baseDuration * 2,\n      });\n      \n      scenes.push({\n        order: 3,\n        duration: baseDuration,\n        visualPrompt: `Close-up: ${productName} reveal, held in hands. Hopeful moment, problem-solving solution presented. Soft backlight creating halo effect.`,\n        visualPromptCN: `特写：${productName}揭晓，双手捧着。充满希望的时刻，问题解决方案呈现。柔和背光营造光晕效果。`,\n        cameraMovement: CAMERA_MOVEMENTS.pushIn,\n        cameraAngle: 'close-up',\n        cameraDistance: CAMERA_DISTANCE.closeUp,\n        subject: `${productName} reveal`,\n        action: 'discovering the solution',\n        environment: 'intimate setting',\n        lighting: LIGHTING_OPTIONS.backlight,\n        mood: 'hopeful, promising',\n        colorTone: 'warm, hopeful palette',\n        transition: 'dissolve',\n        voiceover: language.startsWith('zh') ? `原来答案一直都在这里` : `The answer was here all along`,\n        musicSuggestion: 'uplifting musical moment',\n        startTime: baseDuration * 2,\n        endTime: baseDuration * 3,\n      });\n\n      if (sceneCount >= 5) {\n        scenes.push({\n          order: 4,\n          duration: baseDuration,\n          visualPrompt: `Montage: Quick cuts of ${productName} in action, solving the problem. ${sellingPoints.map(sp => `showing ${sp}`).join(', ')}. Satisfying resolution.`,\n          visualPromptCN: `蒙太奇：${productName}快速剪辑展示，解决问题。${sellingPoints.map(sp => `展示${sp}`).join('、')}。满足的解决方案。`,\n          cameraMovement: CAMERA_MOVEMENTS.handheld,\n          cameraAngle: 'various',\n          cameraDistance: CAMERA_DISTANCE.medium,\n          subject: `${productName} solving problems`,\n          action: 'problem resolution montage',\n          environment: 'various usage contexts',\n          lighting: LIGHTING_OPTIONS.soft,\n          mood: 'satisfying, resolved',\n          colorTone: 'bright, positive',\n          transition: 'cut',\n          voiceover: language.startsWith('zh') ? `一切都不一样了` : `Everything changed`,\n          musicSuggestion: 'building to climax music',\n          startTime: baseDuration * 3,\n          endTime: baseDuration * 4,\n        });\n        \n        scenes.push({\n          order: 5,\n          duration: baseDuration,\n          visualPrompt: `Final emotional shot: Happy transformed person with ${productName}. Life improved, problem solved. Warm satisfying conclusion. Product call to action overlay space.`,\n          visualPromptCN: `最终情感镜头：使用${productName}后快乐蜕变的人物。