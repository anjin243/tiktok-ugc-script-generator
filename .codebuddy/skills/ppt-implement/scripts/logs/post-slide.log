  setIsRecognizing(true);\n        const firstImage = compressedImages[0];\n        \n        // 添加预览图\n        setPreviewUrls(compressedImages);\n        setReferenceImages(compressedImages);\n        \n        // 调用识别API\n        try {\n          const result = await recognizeImageMutation.mutateAsync(firstImage);\n          \n          // 如果商品名称为空，填入识别建议（用户需确认）\n          if (!productName.trim()) {\n            setProductName(result.productName);\n          }\n          \n          // 如果类目在建议列表中，自动选择\n          if (result.suggestions?.categories?.includes(result.category)) {\n            setCategory(result.category);\n          }\n          \n          // 根据是否使用AI显示不同提示\n          if (result.ai) {\n            toast.success(`AI识别成功 (${(result as any).provider})`, {\n              description: `商品：${result.productName}，类目：${result.category}，请确认`,\n              duration: 4000,\n            });\n          } else {\n            toast.info('演示模式：请确认商品信息', {\n              description: `建议：${result.productName}（点击右上角设置可配置AI识别）`,\n              duration: 5000,\n            });\n          }\n        } catch (error) {\n          console.error('Recognition failed:', error);"},"tool_response":"Successfully edited file: /workspace/frontend/src/pages/Create.tsx","client":"CLI","version":"2.90.0","generation_id":"93974bc857154146a6bbda1c5c70d39b","model":"glm-5.0","call_id":"call_f1da458fecae49eda808fd76"}
