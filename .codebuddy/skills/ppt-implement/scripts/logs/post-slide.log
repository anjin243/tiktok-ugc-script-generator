)\n  order        Int\n  duration     Int     // seconds\n  description  String  // Visual description\n  voiceover    String  // Voiceover text for this scene\n  cameraAngle  String? // Camera angle suggestion\n  notes        String? // Shooting notes\n  projectId    String\n  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)\n}\n\n// 素材\nmodel Material {\n  id        String  @id @default(cuid())\n  type      String  // image, text\n  content   String  // URL or text content\n  prompt    String? // AI generation prompt\n  projectId String\n  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)\n}\n","file_path":"/workspace/backend/prisma/schema.prisma"},"tool_response":"Successfully overwrote file: /workspace/backend/prisma/schema.prisma","client":"CLI","version":"2.90.0","generation_id":"57ad5e1af22548d89fcfffc6e237495f","model":"glm-5.0","call_id":"call_7dd34e83afcf40369e5fee18"}
