[2026-04-21 18:14:06] [DEBUG] [PPT PostToolUse Hook] stdin 数据: {"session_id":"2046652003580387328","transcript_path":"/root/.codebuddy/projects/workspace/2046652003580387328.jsonl","cwd":"/workspace","hook_event_name":"PostToolUse","tool_name":"Write","tool_input":{"file_path":"/workspace/backend/src/modules/generate.ts","content":"import { Router, Request, Response } from 'express';\nimport { PrismaClient } from '@prisma/client';\nimport { z } from 'zod';\nimport { GenerateScriptSchema, UGCStyle } from '../types/product.types';\n\nconst router = Router();\nconst prisma = new PrismaClient();\n\n// UGC 风格模板\nconst STYLE_TEMPLATES: Record<UGCStyle, { name: string; description: string; focus: string }> = {\n  unboxing: {\n    name: '开箱测评',\n    description: '从拆快递开始的沉浸式体验',\n    focus: '包装细节、开箱过程、第一印象',\n  },\n  usage: {\n    name: '使用分享',\n    description: '真实使用场景展示',\n    focus: '实际使用、效果展示、使用感受',\n  },\n  comparison: {\n    name: '对比测评',\n    description: '多产品对比分析',\n    focus: '对比优势、差异化卖点、性价比',\n  },\n  story: {\n    name: '剧情植入',\n    description: '融入生活故事场景',\n    focus: '故事情节、情感共鸣、场景代入',\n  },\n  voiceover: {\n    name: '口播讲解',\n    description: '类似直播带货风格',\n    focus: '产品介绍、优惠信息、限时福利',\n  },\n};\n\n// 生成带货脚本\nrouter.post('/script', async (req: Request, res: Response) => {\n  try {\n    const data = GenerateScriptSchema.parse(req.body);\n    const styleTemplate = STYLE_TEMPLATES[data.style];\n    \n    // 根据时长计算场景数\n    const sceneCount = data.duration === 15 ? 3 : data.duration === 30 ? 5 : 8;\n    const sceneDuration = Math.floor(data.duration / sceneCount);\n    \n    // 生成脚本内容\n    const scriptContent = generateScriptContent(data, styleTemplate);\n    \n    // 生成分镜\n    const scenes = generateScenes(data, styleTemplate, sceneCount, sceneDuration);\n    \n    // 生成口播文案\n    const voiceover = generateVoiceover(data, styleTemplate);\n    \n    // 推荐音乐风格\n    const musicStyle = getMusicStyle(data.style);\n    \n    // 保存到数据库\n    const project = await prisma.project.update({\n      where: { id: data.projectId },\n      data: {\n        scriptContent,\n        voiceover,\n        musicStyle,\n        status: 'completed',\n        scenes: {\n          deleteMany: {},\n          create: scenes,\n        },\n      },\n      include: {\n        product: true,\n        scenes: { orderBy: { order: 'asc' } },\n      },\n    });\n    \n    res.json({\n      success: true,\n      data: {\n        project,\n        script: scriptContent,\n        scenes: project.scenes,\n        voiceover,\n        musicStyle,\n      },\n    });\n  } catch (error) {\n    if (error instanceof z.ZodError) {\n      res.status(400).json({ success: false, error: error.errors });\n    } else {\n      console.error('Generate script error:', error);\n      res.status(500).json({ success: false, error: 'Failed to generate script' });\n    }\n  }\n});\n\n// 脚本内容生成\nfunction generateScriptContent(\n  data: z.infer<typeof GenerateScriptSchema>,\n  styleTemplate: { name: string; description: string; focus: string }\n): string {\n  const priceText = data.price ? `，售价${data.price}元` : '';\n  \n  return `【${styleTemplate.name}】${data.productName}带货脚本\n\n商品类目：${data.category}${priceText}\n核心卖点：${data.sellingPoints.join('、')}\n视频时长：${data.duration}秒\n\n内容风格：${styleTemplate.description}\n重点聚焦：${styleTemplate.focus}\n\n---\n脚本已生成完毕，请查看下方分镜详情。\n`;\n}\n\n// 分镜生成\nfunction generateScenes(\n  data: z.infer<typeof GenerateScriptSchema>,\n  styleTemplate: { name: string; description: string; focus: string },\n  sceneCount: number,\n  sceneDuration: number\n) {\n  const scenes = [];\n  const style = data.style;\n  \n  for (let i = 0; i < sceneCount; i++) {\n    const scene = generateSceneByStyle(style, i, sceneCount, sceneDuration, data);\n    scenes.push(scene);\n  }\n  \n  return scenes;\n}\n\nfunction generateSceneByStyle(\n  style: UGCStyle,\n  index: number,\n  total: number,\n  duration: number,\n  data: z.infer<typeof GenerateScriptSchema>\n) {\n  const { productName, sellingPoints, category } = data;\n  \n  const sceneTemplates: Record<UGCStyle, Array<{ description: string; voiceover: string; cameraAngle: string; notes: string }>> = {\n    unboxing: [\n      {\n        description: '展示快递包裹，手持镜头靠近',\n        voiceover: `姐妹们！今天给大家开箱一个超期待的${category}好物！`,\n        cameraAngle: '特写镜头，45度俯拍',\n        notes: '保持真实开箱感，不要提前拆开',\n      },\n      {\n        description: '拆开包装，展示产品外观',\n        voiceover: `看这个包装，质感超好！打开看看里面...`,\n        cameraAngle: '中景，正面展示',\n        notes: '展示包装细节和品牌标识',\n      },\n      {\n        description: '产品细节特写',\n        voiceover: `${sellingPoints[0] || '细节做得很好'}，这个质感真的绝了！`,\n        cameraAngle: '微距特写',\n        notes: '突出产品质感',\n      },\n      {\n        description: '上手使用展示',\n        voiceover: `我来试试效果...哇！${sellingPoints[1] || '效果超棒'}`,\n        cameraAngle: '第一人称视角',\n        notes: '真实使用状态',\n      },\n      {\n        description: '总结展示，给出推荐',\n        voiceover: `整体体验下来，我觉得${productName}真的值得入手！`,\n        cameraAngle: '中景，产品居中',\n        notes: '展示产品全貌和品牌',\n      },\n    ],\n    usage: [\n      {\n        description: '生活场景开场',\n        voiceover: `最近发现一个${category}好物，用了两周来跟大家分享`,\n        cameraAngle: '远景，生活化场景',\n        notes: '自然光，生活化场景',\n      },\n      {\n        description: '产品使用前状态',\n        voiceover: `先看看使用前的问题...`,\n        cameraAngle: '对比镜头',\n        notes: '真实展示问题',\n      },\n      {\n        description: '产品使用过程',\n        voiceover: `用起来很简单，${sellingPoints[0] || '操作方便'}`,\n        cameraAngle: '近景，展示使用方法',\n        notes: '步骤清晰',\n      },\n      {\n        description: '使用后效果对比',\n        voiceover: `看看效果！${sellingPoints[1] || '效果明显'}对吧！`,\n        cameraAngle: '对比镜头',\n        notes: '前后对比要明显',\n      },\n      {\n        description: '总结推荐',\n        voiceover: `${productName}我用了两周，真心推荐给有同样需求的朋友`,\n        cameraAngle: '中景，自然展示',\n        notes: '真诚推荐感',\n      },\n    ],\n    comparison: [\n      {\n        description: '两产品并列展示',\n        voiceover: `今天对比两款热门${category}，帮大家避坑！`,\n        cameraAngle: '分屏对比',\n        notes: '产品位置固定',\n      },\n      {\n        description: '第一款产品展示',\n        voiceover: `第一款是${productName}...`,\n        cameraAngle: '产品特写',\n        notes: '介绍第一款',\n      },\n      {\n        description: '第二款产品展示',\n        voiceover: `第二款是竞品...`,\n        cameraAngle: '产品特写',\n        notes: '介绍第二款',\n      },\n      {\n        description: '核心卖点对比',\n        voiceover: `${sellingPoints[0] || '关键点'}方面...`,\n        cameraAngle: '对比展示',\n        notes: '客观对比',\n      },\n      {\n        description: '结论推荐',\n        voiceover: `综合来看，${productName}的${sellingPoints[1] || '性价比'}更高！`,\n        cameraAngle: '推荐款突出',\n        notes: '给出明确结论',\n      },\n    ],\n    story: [\n      {\n        description: '生活化场景开场',\n        voiceover: `最近遇到一个烦心事...`,\n        cameraAngle: '远景，生活化',\n        notes: '引起共鸣',\n      },\n      {\n        description: '问题场景展示',\n        voiceover: `直到朋友推荐了${productName}`,\n        cameraAngle: '中景，自然过渡',\n        notes: '自然植入',\n      },\n      {\n        description: '产品出场',\n        voiceover: `就是这个！`,\n        cameraAngle: '产品特写',\n        notes: '自然呈现产品',\n      },\n      {\n        description: '使用过程',\n        voiceover: `${sellingPoints[0] || '用了之后'}...`,\n        cameraAngle: '使用镜头',\n        notes: '真实使用',\n      },\n      {\n        description: '问题解决',\n        voiceover: `没想到${sellingPoints[1] || '效果这么好'}！`,\n        cameraAngle: '效果展示',\n        notes: '惊喜感',\n      },\n    ],\n    voiceover: [\n      {\n        description: '产品全貌展示',\n        voiceover: `家人们！${productName}来啦！`,\n        cameraAngle: '产品正面特写',\n        notes: '吸引力开场',\n      },\n      {\n        description: '核心卖点展示',\n        voiceover: `${sellingPoints[0] || '核心卖点'}，真的超值！`,\n        cameraAngle: '功能展示',\n        notes: '快速展示卖点',\n      },\n      {\n        description: '使用效果',\n        voiceover: `${sellingPoints[1] || '效果展示'}，看这效果！`,\n        cameraAngle: '效果对比',\n        notes: '视觉冲击',\n      },\n      {\n        description: '优惠信息',\n        voiceover: `现在下单还有优惠！`,\n        cameraAngle: '价格展示',\n        notes: '限时感',\n      },\n      {\n        description: '行动号召',\n        voiceover: `赶紧冲！链接在评论区！`,\n        cameraAngle: '产品展示',\n        notes: '引导购买',\n      },\n    ],\n  };\n  \n  const templates = sceneTemplates[style];\n  const templateIndex = Math.min(index, templates.length - 1);\n  const template = templates[templateIndex];\n  \n  return {\n    order: index + 1,\n    duration,\n    description: template.description.replace('{product}', productName),\n    voiceover: template.voiceover,\n    cameraAngle: template.cameraAngle,\n    notes: template.notes,\n  };\n}\n\n// 口播文案生成\nfunction generateVoiceover(\n  data: z.infer<typeof GenerateScriptSchema>,\n  styleTemplate: { name: string; description: string; focus: string }\n): string {\n  const { productName, sellingPoints, category } = data;\n  \n  return `【完整口播文案】\n\n哈喽姐妹们！今天给大家分享${category}里的宝藏好物——${productName}！\n\n${sellingPoints.map((p, i) => `${i + 1}. ${p}`).join('\\n')}\n\n用下来真的太香了，姐妹们可以放心冲！\n\n记得点赞收藏，有问题评论区见～`;\n}\n\n// 音乐风格推荐\nfunction getMusicStyle(style: UGCStyle): string {\n  const musicStyles: Record<UGCStyle, string> = {\n    unboxing: '轻快节奏感音乐，有开箱惊喜感',\n    usage: '轻松生活化背景音乐，舒适自然',\n    comparison: '专业感配乐，中性客观',\n    story: '情感化音乐，根据剧情变化',\n    voiceover: '快节奏电子音乐，直播间氛围感',\n  };\n  \n  return musicStyles[style];\n}\n\nexport default router;\n"},"tool_response":"Successfully created and wrote to new file: /workspace/backend/src/modules/generate.ts","client":"CLI","version":"2.90.0","generation_id":"fc98ede5bf9e4b5eb72a720089f57ccd","model":"glm-5.0","call_id":"call_e9b06c4ec92947ef8096b580"}
