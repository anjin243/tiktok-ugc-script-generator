ent if you have questions!\",\n  },\n  'es-ES': {\n    greeting: '¡Hola chicas!',\n    intro: 'Hoy les comparto',\n    callToAction: '¡Consíguelo ahora! ¡Enlace en la descripción!',\n    closing: '¡No olviden dar like y guardar! ¡Déjenme sus comentarios!',\n  },\n  'pt-BR': {\n    greeting: 'Oi meninas!',\n    intro: 'Hoje vou compartilhar com vocês',\n    callToAction: 'Pegue o seu agora! Link na descrição!',\n    closing: 'Não esqueça de curtir e salvar! Comente suas dúvidas!',\n  },\n  'id-ID': {\n    greeting: 'Hai semuanya!',\n    intro: 'Hari ini aku mau share',\n    callToAction: 'Buruan beli! Link di bio!',\n    closing: 'Jangan lupa like dan save! Coment kalau ada pertanyaan!',\n  },\n  'th-TH': {\n    greeting: 'สวัสดีค่ะทุกคน!',\n    intro: 'วันนี้จะมาแชร์',\n    callToAction: 'รีบไปดูเลย! ลิงก์อยู่ในคอมเมนต์!',\n    closing: 'อย่าลืมกดไลค์และเซฟนะคะ! มีคำถามคอมเมนต์ได้เลย!',\n  },\n  'vi-VN': {\n    greeting: 'Chào mọi người!',\n    intro: 'Hôm nay mình sẽ chia sẻ',\n    callToAction: 'Mua ngay nhé! Link ở phần bình luận!',\n    closing: 'Đừng quên like và lưu nhé! Có gì comment bên dưới nhé!',\n  },\n  'fil-PH': {\n    greeting: 'Hi mga sis!',\n    intro: 'Today I\\'m sharing with you',\n    callToAction: 'Order na! Link sa bio!',\n    closing: 'Don\\'t forget to like and save! Comment your questions!',\n  },\n  'ms-MY': {\n    greeting: 'Hai semua!',\n    intro: 'Hari ni nak share',\n    callToAction: 'Bel sekarang! Link di bio!',\n    closing: 'Jangan lupa like dan save! Comment kalau ada soalan!',\n  },\n  'ar-SA': {\n    greeting: 'مرحبا يا فتيات!',\n    intro: 'اليوم أشارككم',\n    callToAction: 'اطلبي الآن! الرابط في الوصف!',\n    closing: 'لا تنسوا الإعجاب والحفظ! اكتبوا تعليقاتكم!',\n  },\n  'ja-JP': {\n    greeting: 'みなさんこんにちは！',\n    intro: '今日はみなさんにシェアします',\n    callToAction: '今すぐチェック！リンクはコメント欄で！',\n    closing: 'いいねと保存をお忘れなく！コメントお待ちしてます！',\n  },\n  'ko-KR': {\n    greeting: '안녕하세요 여러분!',\n    intro: '오늘 여러분께 공유할',\n    callToAction: '지금 바로 확인하세요! 링크는 댓글에!',\n    closing: '좋아요와 저장 잊지 마세요! 댓글로 질문해주세요!',\n  },\n  'fr-FR': {\n    greeting: 'Salut les filles!',\n    intro: \"Aujourd'hui je partage avec vous\",\n    callToAction: 'Commandez maintenant! Lien dans la description!',\n    closing: \"N'oubliez pas de liker et sauvegarder! Posez vos questions en commentaire!\",\n  },\n  'de-DE': {\n    greeting: 'Hallo zusammen!',\n    intro: 'Heute teile ich mit euch',\n    callToAction: 'Jetzt bestellen! Link in der Beschreibung!',\n    closing: 'Vergesst nicht zu liken und zu speichern! Schreibt eure Fragen in die Kommentare!',\n  },\n};\n\n// 生成带货脚本\nrouter.post('/script', async (req: Request, res: Response) => {\n  try {\n    const data = GenerateScriptSchema.parse(req.body);\n    const styleTemplate = STYLE_TEMPLATES[data.style];\n    const langTemplate = LANGUAGE_TEMPLATES[data.language || 'zh-CN'];\n    \n    // 根据时长计算场景数\n    const sceneCount = data.duration === 15 ? 3 : data.duration === 30 ? 5 : 8;\n    const sceneDuration = Math.floor(data.duration / sceneCount);\n    \n    // 生成脚本内容\n    const scriptContent = generateScriptContent(data, styleTemplate, langTemplate);\n    \n    // 生成分镜\n    const scenes = generateScenes(data, styleTemplate, langTemplate, sceneCount, sceneDuration);\n    \n    // 生成口播文案\n    const voiceover = generateVoiceover(data, styleTemplate, langTemplate);\n    \n    // 推荐音乐风格\n    const musicStyle = getMusicStyle(data.style);\n    \n    // 保存到数据库\n    const project = await prisma.project.update({\n      where: { id: data.projectId },\n      data: {\n        scriptContent,\n        voiceover,\n        musicStyle,\n        status: 'completed',\n        language: data.language || 'zh-CN',\n        aspectRatio: data.aspectRatio || '9:16',\n        referenceImages: data.referenceImages || [],\n        scenes: {\n          deleteMany: {},\n          create: scenes,\n        },\n      },\n      include: {\n        product: true,\n        scenes: { orderBy: { order: 'asc' } },\n      },\n    });\n    \n    res.json({\n      success: true,\n      data: {\n        project,\n        script: scriptContent,\n        scenes: project.scenes,\n        voiceover,\n        musicStyle,\n      },\n    });\n  } catch (error) {\n    if (error instanceof z.ZodError) {\n      res.status(400).json({ success: false, error: error.errors });\n    } else {\n      console.error('Generate script error:', error);\n      res.status(500).json({ success: false, error: 'Failed to generate script' });\n    }\n  }\n});\n\n// 脚本内容生成\nfunction generateScriptContent(\n  data: z.infer<typeof GenerateScriptSchema>,\n  styleTemplate: { name: string; description: string; focus: string },\n  langTemplate: { greeting: string; intro: string; callToAction: string; closing: string }\n): string {\n  const priceText = data.price ? ` · ${data.price}` : '';\n  const langName = LANGUAGE_TEMPLATES[data.language || 'zh-CN'] ? \n    Object.keys(LANGUAGE_TEMPLATES).find(k => k === data.language) : 'zh-CN';\n  \n  return `【${styleTemplate.name}】${data.productName} ${langTemplate.greeting}\n\n${langTemplate.intro} ${data.category}${priceText}\n${data.sellingPoints.map((p, i) => `${i + 1}. ${p}`).join('\\n')}\n\n视频时长：${data.duration}秒\n视频比例：${data.aspectRatio || '9:16'}\n语言版本：${data.language || 'zh-CN'}\n\n内容风格：${styleTemplate.description}\n重点聚焦：${styleTemplate.focus}\n\n---\n脚本已生成完毕，请查看下方分镜详情。\n`;\n}\n\n// 分镜生成\nfunction generateScenes(\n  data: z.infer<typeof GenerateScriptSchema>,\n  styleTemplate: { name: string; description: string; focus: string },\n  langTemplate: { greeting: string; intro: string; callToAction: string; closing: string },\n  sceneCount: number,\n  sceneDuration: number\n) {\n  const scenes = [];\n  const style = data.style;\n  const lang = data.language || 'zh-CN';\n  \n  for (let i = 0; i < sceneCount; i++) {\n    const scene = generateSceneByStyle(style, i, sceneCount, sceneDuration, data, langTemplate);\n    scenes.push(scene);\n  }\n  \n  return scenes;\n}\n\nfunction generateSceneByStyle(\n  style: UGCStyle,\n  index: number,\n  total: number,\n  duration: number,\n  data: z.infer<typeof GenerateScriptSchema>,\n  lang: { greeting: string; intro: string; callToAction: string; closing: string }\n) {\n  const { productName, sellingPoints, category } = data;\n  \n  // 基于语言的场景模板\n  const sceneTemplates: Record<UGCStyle, Array<{ description: string; voiceover: string; cameraAngle: string; notes: string }>> = {\n    unboxing: [\n      {\n        description: 'Show the package/parcel, handheld camera close-up',\n        voiceover: `${lang.greeting} ${lang.intro} ${category} must-have!`,\n        cameraAngle: 'Close-up, 45-degree overhead shot',\n        notes: 'Keep it authentic, don\\'t open beforehand',\n      },\n      {\n        description: 'Open the package, reveal product appearance',\n        voiceover: `Look at this packaging! The quality is amazing! Let me show you inside...`,\n        cameraAngle: 'Medium shot, front view',\n        notes: 'Show packaging details and brand logo',\n      },\n      {\n        description: 'Product details close-up',\n        voiceover: `${sellingPoints[0] || 'Great details'} - This quality is incredible!`,\n        cameraAngle: 'Macro close-up',\n        notes: 'Highlight product texture',\n      },\n      {\n        description: 'Hands-on demonstration',\n        voiceover: `Let me try it out... Wow! ${sellingPoints[1] || 'It works great'}`,\n        cameraAngle: 'First-person POV',\n        notes: 'Show actual usage',\n      },\n      {\n        description: 'Summary and recommendation',\n        voiceover: `Overall, ${productName} is definitely worth getting!`,\n        cameraAngle: 'Medium shot, product centered',\n        notes: 'Show full product and brand',\n      },\n    ],\n    usage: [\n      {\n        description: 'Lifestyle scene opening',\n        voiceover: `I found an amazing ${category} product and want to share with you after using it for 2 weeks`,\n        cameraAngle: 'Wide shot, lifestyle setting',\n        notes: 'Natural lighting, real-life setting',\n      },\n      {\n        description: 'Before usage state',\n        voiceover: `First, let me show you the problem before using...`,\n        cameraAngle: 'Comparison shot',\n        notes: 'Show the real issue',\n      },\n      {\n        description: 'Product usage process',\n        voiceover: `It\\'s so easy to use, ${sellingPoints[0] || 'super convenient'}`,\n        cameraAngle: 'Close-up, show how to use',\n        notes: 'Clear steps',\n      },\n      {\n        description: 'After usage effect comparison',\n        voiceover: `Look at the results! ${sellingPoints[1] || 'The effect is obvious'}, right?`,\n        cameraAngle: 'Comparison shot',\n        notes: 'Make before/after obvious',\n      },\n      {\n        description: 'Summary and recommendation',\n        voiceover: `I\\'ve been using ${productName} for 2 weeks, highly recommend it!`,\n        cameraAngle: 'Medium shot, natural display',\n        notes: 'Sincere recommendation vibe',\n      },\n    ],\n    comparison: [\n      {\n        description: 'Two products side by side',\n        voiceover: `Today comparing two popular ${category} products to help you choose!`,\n        cameraAngle: 'Split screen comparison',\n        notes: 'Keep product positions fixed',\n      },\n      {\n        description: 'First product showcase',\n        voiceover: `First one is ${productName}...`,\n        cameraAngle: 'Product close-up',\n        notes: 'Introduce first product',\n      },\n      {\n        description: 'Second product showcase',\n        voiceover: `Second one is the competitor...`,\n        cameraAngle: 'Product close-up',\n        notes: 'Introduce second product',\n      },\n      {\n        description: 'Key selling point comparison',\n        voiceover: `In terms of ${sellingPoints[0] || 'key features'}...`,\n        cameraAngle: 'Comparison display',\n        notes: 'Objective comparison',\n      },\n      {\n        description: 'Conclusion and recommendation',\n        voiceover: `Overall, ${productName} has better ${sellingPoints[1] || 'value'}!`,\n        cameraAngle: 'Highlight the recommended one',\n        notes: 'Give clear conclusion',\n      },\n    ],\n    story: [\n      {\n        description: 'Lifestyle scene opening',\n        voiceover: `I was dealing with this problem recently...`,\n        cameraAngle: 'Wide shot, lifestyle',\n        notes: 'Create relatability',\n      },\n      {\n        description: 'Problem scene',\n        voiceover: `Then a friend recommended ${productName}`,\n        cameraAngle: 'Medium shot, natural transition',\n        notes: 'Natural product placement',\n      },\n      {\n        description: 'Product appearance',\n        voiceover: `This is it!`,\n        cameraAngle: 'Product close-up',\n        notes: 'Naturally reveal product',\n      },\n      {\n        description: 'Usage process',\n        voiceover: `After using it... ${sellingPoints[0] || 'It worked'}...`,\n        cameraAngle: 'Usage shot',\n        notes: 'Show actual usage',\n      },\n      {\n        description: 'Problem solved',\n        voiceover: `I can\\'t believe ${sellingPoints[1] || 'it worked so well'}!`,\n        cameraAngle: 'Effect showcase',\n        notes: 'Surprise moment',\n      },\n    ],\n    voiceover: [\n      {\n        description: 'Full product display',\n        voiceover: `${lang.greeting} ${productName} is here!`,\n        cameraAngle: 'Product front close-up',\n        notes: 'Attention-grabbing opening',\n      },\n      {\n        description: 'Key selling point showcase',\n        voiceover: `${sellingPoints[0] || 'Key feature'}, seriously worth it!`,\n        cameraAngle: 'Feature demonstration',\n        notes: 'Quick showcase of points',\n      },\n      {\n        description: 'Usage effect',\n        voiceover: `${sellingPoints[1] || 'Effect display'}, look at this!`,\n        cameraAngle: 'Effect comparison',\n        notes: 'Visual impact',\n      },\n      {\n        description: 'Special offer info',\n        voiceover: `Order now for special discount!`,\n        cameraAngle: 'Price display',\n        notes: 'Create urgency',\n      },\n      {\n        description: 'Call to action',\n        voiceover: lang.callToAction,\n        cameraAngle: 'Product display',\n        notes: 'Guide to purchase',\n      },\n    ],\n  };\n  \n  const templates = sceneTemplates[style];\n  const templateIndex = Math.min(index, templates.length - 1);\n  const template = templates[templateIndex];\n  \n  return {\n    order: index + 1,\n    duration,\n    description: template.description,\n    voiceover: template.voiceover,\n    cameraAngle: template.cameraAngle,\n    notes: template.notes,\n  };\n}\n\n// 口播文案生成\nfunction generateVoiceover(\n  data: z.infer<typeof GenerateScriptSchema>,\n  styleTemplate: { name: string; description: string; focus: string },\n  lang: { greeting: string; intro: string; callToAction: string; closing: string }\n): string {\n  const { productName, sellingPoints, category } = data;\n  \n  return `【Full Voiceover Script】\n\n${lang.greeting} ${lang.intro} ${category} gem - ${productName}!\n\n${sellingPoints.map((p, i) => `${i + 1}. ${p}`).join('\\n')}\n\nIt's seriously amazing, you can trust this one!\n\n${lang.closing}`;\n}\n\n// 音乐风格推荐\nfunction getMusicStyle(style: UGCStyle): string {\n  const musicStyles: Record<UGCStyle, string> = {\n    unboxing: 'Upbeat energetic music with unboxing excitement feel',\n    usage: 'Relaxed lifestyle background music, natural and comfortable',\n    comparison: 'Professional scoring, neutral and objective',\n    story: 'Emotional music that changes with the story',\n    voiceover: 'Upbeat electronic music, livestream atmosphere',\n  };\n  \n  return musicStyles[style];\n}\n\nexport default router;\n","file_path":"/workspace/backend/src/modules/generate.ts"},"tool_response":"Successfully overwrote file: /workspace/backend/src/module