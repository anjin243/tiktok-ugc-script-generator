# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# Optional database. Replace placeholders locally; never commit real credentials.
DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/YOUR_DATABASE?schema=public"

CORS_ORIGIN=http://localhost:5174
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=info

# Paid OpenAI Videos API. Keep the real value only in backend/.env or the process environment.
# Never expose this value to the frontend and never commit a real key.
OPENAI_API_KEY=
